---
const services = ['SEO', 'AI search', 'PPC', 'Social media', 'Web design', 'Content', 'eCommerce', 'Not sure yet'];
const markets = ['United States', 'United Kingdom', 'Australia', 'Canada', 'UAE', 'Singapore', 'Several markets'];
const budgets = ['Under $2k', '$2k–5k', '$5k–10k', '$10k–25k', '$25k+'];
---

<form class="rounded-2xl border border-line bg-white p-6 shadow-sm" data-proposal-form novalidate>
  <div data-step="1">
    <h3 class="text-xl font-bold">What do you need help with?</h3>
    <p class="mt-1 text-sm text-slate">Pick all that apply</p>
    <fieldset class="mt-4 flex flex-wrap gap-2">
      <legend class="sr-only">Services</legend>
      {
        services.map((service) => (
          <label class="cursor-pointer rounded-full border border-line px-4 py-2 text-sm font-medium has-checked:border-violet has-checked:bg-violet-50 has-checked:text-violet-600">
            <input type="checkbox" name="services" value={service} class="sr-only" />
            {service}
          </label>
        ))
      }
    </fieldset>
    <button type="button" class="mt-6 rounded-full bg-violet px-6 py-3 font-display text-sm font-bold text-white hover:bg-violet-600" data-next>
      Next
    </button>
  </div>

  <div data-step="2" hidden>
    <h3 class="text-xl font-bold">Where and how much?</h3>
    <label class="mt-4 block font-bold" for="proposal-market">Main market</label>
    <select id="proposal-market" name="market" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5">
      {markets.map((market) => <option value={market}>{market}</option>)}
    </select>
    <fieldset class="mt-6">
      <legend class="font-bold">Monthly marketing budget</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          budgets.map((budget) => (
            <label class="cursor-pointer rounded-full border border-line px-4 py-2 text-sm font-medium has-checked:border-violet has-checked:bg-violet-50 has-checked:text-violet-600">
              <input type="radio" name="budget" value={budget} class="sr-only" />
              {budget}
            </label>
          ))
        }
      </div>
    </fieldset>
    <div class="mt-6 flex gap-3">
      <button type="button" class="rounded-full border border-line bg-white px-6 py-3 font-display text-sm font-bold text-navy" data-back>
        Back
      </button>
      <button type="button" class="rounded-full bg-violet px-6 py-3 font-display text-sm font-bold text-white hover:bg-violet-600" data-next>
        Next
      </button>
    </div>
  </div>

  <div data-step="3" hidden>
    <h3 class="text-xl font-bold">Where should we send your plan?</h3>
    <label class="mt-4 block font-bold" for="proposal-name">Name</label>
    <input id="proposal-name" name="name" type="text" autocomplete="name" required class="mt-2 w-full rounded-lg border border-line px-3 py-2.5" />
    <label class="mt-4 block font-bold" for="proposal-email">Work email</label>
    <input id="proposal-email" name="email" type="email" autocomplete="email" required class="mt-2 w-full rounded-lg border border-line px-3 py-2.5" />
    <label class="mt-4 block font-bold" for="proposal-website">Website</label>
    <input id="proposal-website" name="website" type="url" autocomplete="url" placeholder="https://" class="mt-2 w-full rounded-lg border border-line px-3 py-2.5" />
    <div class="mt-6 flex gap-3">
      <button type="button" class="rounded-full border border-line bg-white px-6 py-3 font-display text-sm font-bold text-navy" data-back>
        Back
      </button>
      <button type="submit" class="rounded-full bg-violet px-6 py-3 font-display text-sm font-bold text-white hover:bg-violet-600">
        Get a free proposal
      </button>
    </div>
    <p class="mt-4 hidden text-sm font-medium text-navy" data-form-note>
      Thanks — this form is connected in Phase 1, step 6, with Turnstile and lead routing.
    </p>
  </div>
  <p class="mt-4 text-sm text-slate" data-step-label>Step 1 of 3</p>
</form>
<script>
  const form = document.querySelector('[data-proposal-form]');
  if (form) {
    const steps = Array.from(form.querySelectorAll('[data-step]'));
    const label = form.querySelector('[data-step-label]');
    let current = 0;
    const show = (index: number) => {
      current = index;
      steps.forEach((step, i) => {
        (step as HTMLElement).hidden = i !== index;
      });
      if (label) label.textContent = `Step ${index + 1} of 3`;
    };
    form.querySelectorAll('[data-next]').forEach((button) =>
      button.addEventListener('click', () => show(Math.min(current + 1, steps.length - 1))),
    );
    form.querySelectorAll('[data-back]').forEach((button) =>
      button.addEventListener('click', () => show(Math.max(current - 1, 0))),
    );
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      form.querySelector('[data-form-note]')?.classList.remove('hidden');
    });
  }
</script>
