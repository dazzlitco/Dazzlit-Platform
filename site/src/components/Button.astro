---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'orange';
  external?: boolean;
}

const { href, variant = 'primary', external = false } = Astro.props;

const styles = {
  primary:
    'inline-flex items-center justify-center rounded-full bg-violet px-6 py-3 font-display text-sm font-bold text-white transition hover:bg-violet-600 focus-visible:outline-3 focus-visible:outline-violet',
  secondary:
    'inline-flex items-center justify-center rounded-full border border-line bg-white px-6 py-3 font-display text-sm font-bold text-navy transition hover:border-violet hover:text-violet-600',
  orange:
    'inline-flex items-center justify-center rounded-full bg-orange px-6 py-3 font-display text-sm font-bold text-navy transition hover:brightness-95',
};
---

<a href={href} class={styles[variant]} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <slot />
</a>
