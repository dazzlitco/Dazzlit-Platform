---
import type { PageEntry } from '../lib/templates';
import { ctaDisplay } from '../lib/templates';

interface Props {
  entry: PageEntry;
}

const { entry } = Astro.props;
const { data } = entry;
---

<header class="border-b border-line bg-ivory">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <p class="text-sm font-bold uppercase tracking-wide text-violet-600">
      {data.pillar}
      {data.topic && data.topic !== data.pillar ? ` · ${data.topic}` : ''}
    </p>
    <h1 class="mt-3 max-w-3xl font-display text-4xl font-extrabold tracking-tight text-navy md:text-5xl">
      {data.title}
    </h1>
    <p class="mt-4 max-w-3xl text-lg text-slate">{data.metaDescription}</p>
    <div class="mt-6">
      <a
        href="/contact/"
        class="inline-block rounded-full bg-violet px-6 py-3 font-display text-sm font-bold text-white hover:bg-violet-600"
      >
        {ctaDisplay(data.cta)}
      </a>
    </div>
  </div>
</header>
