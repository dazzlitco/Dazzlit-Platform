---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = 'Questions, answered.' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<section class="mx-auto max-w-3xl px-6 py-16">
  <h2 class="text-3xl font-extrabold">{heading}</h2>
  <div class="mt-8 space-y-4">
    {
      items.map((item) => (
        <details class="rounded-2xl border border-line bg-white p-5">
          <summary class="cursor-pointer font-display font-bold text-navy">{item.question}</summary>
          <p class="mt-3 text-slate">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
