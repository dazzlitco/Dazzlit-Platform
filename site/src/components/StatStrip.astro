---
export interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-2 gap-6 py-10 md:grid-cols-4">
  {
    stats.map((stat) => (
      <div class="text-center">
        <p class="font-display text-4xl font-extrabold text-violet">{stat.value}</p>
        <p class="mt-1 font-medium text-slate">{stat.label}</p>
      </div>
    ))
  }
</div>
