---
import { SOLUTION_GROUPS, RESOURCE_LINKS, MARKETS } from '../data/navigation';

const solutionLinks = SOLUTION_GROUPS.flatMap((group) => group.links);
---

<footer class="bg-navy text-white">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <img src="/dazzlit-logo-white.svg" alt="Dazzlit" width="150" height="40" loading="lazy" />
        <p class="mt-4 max-w-sm text-white/80">Ideas that travel. Brands that grow.</p>
        <p class="mt-4 text-white/80">The monthly roundup, in your inbox</p>
        <a href="/blog/" class="mt-2 inline-block rounded-full bg-violet px-5 py-2.5 font-display text-sm font-bold text-white hover:bg-violet-600">
          Subscribe
        </a>
      </div>
      <nav aria-label="Solutions">
        <p class="font-display font-bold text-white">Solutions</p>
        <ul class="mt-4 space-y-2">
          {
            solutionLinks.slice(0, 5).map((link) => (
              <li>
                <a href={link.href} class="text-white/80 hover:text-violet-300">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/services/" class="font-bold text-white hover:text-violet-300">
              All 20 services →
            </a>
          </li>
        </ul>
      </nav>
      <nav aria-label="Resources">
        <p class="font-display font-bold text-white">Resources</p>
        <ul class="mt-4 space-y-2">
          {
            RESOURCE_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-white/80 hover:text-violet-300">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/blog/" class="text-white/80 hover:text-violet-300">
              Blog
            </a>
          </li>
        </ul>
      </nav>
      <nav aria-label="Company and markets">
        <p class="font-display font-bold text-white">Company</p>
        <ul class="mt-4 space-y-2">
          <li><a href="/about/" class="text-white/80 hover:text-violet-300">About</a></li>
          <li><a href="/case-studies/" class="text-white/80 hover:text-violet-300">Case studies</a></li>
          <li><a href="/pricing/" class="text-white/80 hover:text-violet-300">Pricing</a></li>
          <li><a href="/contact/" class="text-white/80 hover:text-violet-300">Submit an RFP</a></li>
          <li><a href="/contact/" class="text-white/80 hover:text-violet-300">Contact</a></li>
        </ul>
        <p class="mt-6 font-display font-bold text-white">Markets</p>
        <ul class="mt-4 space-y-2">
          {
            MARKETS.map((market) => (
              <li>
                <a href={market.href} class="text-white/80 hover:text-violet-300">
                  {market.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-white/15 pt-6 text-sm text-white/70">
      <p>© 2026 Dazzlit. All rights reserved.</p>
      <nav class="flex flex-wrap gap-5" aria-label="Legal">
        <a href="/privacy/" class="hover:text-violet-300">Privacy</a>
        <a href="/terms/" class="hover:text-violet-300">Terms</a>
        <a href="/cookies/" class="hover:text-violet-300">Cookies</a>
        <a href="/accessibility/" class="hover:text-violet-300">Accessibility</a>
      </nav>
    </div>
  </div>
</footer>
