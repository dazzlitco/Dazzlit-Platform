---
interface Props {
  resultValue: string;
  resultLabel: string;
  resultValue2?: string;
  resultLabel2?: string;
  service: string;
  industry?: string;
  market?: string;
  clientName?: string;
  headline: string;
  summary: string;
  href: string;
}

const {
  resultValue,
  resultLabel,
  resultValue2,
  resultLabel2,
  service,
  industry,
  market,
  clientName,
  headline,
  summary,
  href,
} = Astro.props;

const context = [service, industry, market].filter(Boolean).join(' · ');
---

<article class="overflow-hidden rounded-2xl border border-line bg-white">
  <div class="bg-navy px-6 py-5 text-white">
    <p class="font-display text-4xl font-extrabold text-orange">{resultValue}</p>
    <p class="mt-1 text-white/80">{resultLabel}</p>
    {
      resultValue2 && resultLabel2 && (
        <p class="mt-3 border-t border-white/15 pt-3">
          <span class="font-display text-2xl font-extrabold text-orange">{resultValue2}</span>{' '}
          <span class="text-white/80">{resultLabel2}</span>
        </p>
      )
    }
  </div>
  <div class="p-6">
    <p class="text-xs font-bold uppercase tracking-wide text-slate">{context}</p>
    <h3 class="mt-3 text-xl font-bold">
      {clientName ? `${clientName}: ` : ''}
      {headline}
    </h3>
    <p class="mt-3 text-slate">{summary}</p>
    <a href={href} class="mt-4 inline-block font-bold text-violet-600">
      Read the case study →
    </a>
  </div>
</article>
