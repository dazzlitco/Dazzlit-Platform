---
// T2 — Service hub (plan, section 4): hero, sub-service grid, process,
// results, pricing teaser, industries, FAQ, related resources. The body
// (H2 sections) carries the process and detail copy, written in Phase 2.
// Sections that need proof assets (results, case studies) are not rendered
// until those assets are supplied.
import TemplateShell from './TemplateShell.astro';
import type { TemplateProps } from '../../lib/templates';

type Props = TemplateProps;

const { entry, trail, children } = Astro.props;
---

<TemplateShell entry={entry} trail={trail}>
  <section slot="beforeBody" class="mx-auto max-w-7xl px-6 py-10">
    <h2 class="font-display text-2xl font-bold text-navy">Services in this area</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        children.map((child) => (
          <li class="rounded-2xl border border-line bg-white p-5">
            <a href={child.data.url} class="font-display text-lg font-bold text-navy hover:text-violet-600">
              {child.data.title}
            </a>
            <p class="mt-2 text-sm text-slate">{child.data.metaDescription}</p>
          </li>
        ))
      }
    </ul>
  </section>
  <slot />
</TemplateShell>
