---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  heading: string;
  updated?: string;
}

const { title, description, canonicalPath, heading, updated } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <main class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-display text-4xl font-extrabold tracking-tight text-navy">{heading}</h1>
    {updated && <p class="mt-3 text-sm text-slate">Last updated: {updated}</p>}
    <div class="mt-8 space-y-5 text-slate [h2]:mt-10 [h2]:font-display [h2]:text-2xl [h2]:font-bold [h2]:text-navy [p]:leading-relaxed [ul]:list-disc [ul]:space-y-2 [ul]:pl-6 [a]:font-medium [a]:text-violet-600 [a]:underline">
      <slot />
    </div>
  </main>
</BaseLayout>
