---
// Homepage — rendered through the T1 template layout. The page itself is
// built in Phase 2 from the approved homepage mockup; this is the Phase 1
// preview of the template's sections.
import { getCollection } from 'astro:content';
import T01Home from '../layouts/templates/T01Home.astro';
import { breadcrumbTrail, childrenOf, bodyHeadings } from '../lib/templates';

const core = await getCollection('core');
const home = core.find((entry) => entry.data.url === '/');
if (!home) throw new Error('Home entry (/) not found in the core collection.');
const trail = breadcrumbTrail(core, home);
const children = childrenOf(core, home.data.url);
const headings = bodyHeadings(home.body);
---

<T01Home entry={home} trail={trail} children={children} headings={headings} />
