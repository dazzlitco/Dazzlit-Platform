---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dazzlit | Global Digital Marketing Agency"
  description="Dazzlit is a global digital marketing agency: SEO, PPC, social, content, web design, CRO and AI marketing that grow revenue. Get a free proposal."
  canonicalPath="/"
>
  <main class="mx-auto max-w-3xl px-6 py-24 text-center">
    <img src="/dazzlit-logo.svg" alt="Dazzlit" width="180" height="48" class="mx-auto" />
    <h1 class="mt-10 text-5xl font-extrabold">
      Reach your <span class="text-violet">next market.</span>
    </h1>
    <p class="mt-6 text-lg text-slate">Ideas that travel. Brands that grow.</p>
    <p class="mt-10 text-slate">
      Site scaffold — Phase 1. The homepage and service pages are built in
      Phase 2, from the approved homepage mockup and the Wave 1 briefs.
    </p>
  </main>
</BaseLayout>
