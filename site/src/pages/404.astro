---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Dazzlit"
  description="The page you were looking for does not exist or has moved."
  canonicalPath="/404/"
>
  <main class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="font-display text-6xl font-extrabold text-violet">404</p>
    <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-navy">This page is not here</h1>
    <p class="mx-auto mt-4 max-w-xl text-slate">
      The page you were looking for does not exist, or it has moved. Try the
      homepage, or one of our services below.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-violet px-6 py-3 font-display text-sm font-bold text-white hover:bg-violet-600">Back to the homepage</a>
      <a href="/services/" class="rounded-full border border-line bg-white px-6 py-3 font-display text-sm font-bold text-navy">All services</a>
      <a href="/services/seo/" class="rounded-full border border-line bg-white px-6 py-3 font-display text-sm font-bold text-navy">SEO services</a>
      <a href="/contact/" class="rounded-full border border-line bg-white px-6 py-3 font-display text-sm font-bold text-navy">Contact us</a>
    </div>
  </main>
</BaseLayout>
