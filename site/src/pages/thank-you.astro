---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thank you | Dazzlit"
  description="Thanks for your request — Dazzlit will be in touch soon."
  canonicalPath="/thank-you/"
>
  <main class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="font-display text-3xl font-extrabold tracking-tight text-navy">Thanks — your request is in</h1>
    <p class="mx-auto mt-4 max-w-xl text-slate">
      We have your request and will be in touch soon. While you wait, you can
      look at our services or read more about how we work.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-violet px-6 py-3 font-display text-sm font-bold text-white hover:bg-violet-600">Back to the homepage</a>
      <a href="/services/" class="rounded-full border border-line bg-white px-6 py-3 font-display text-sm font-bold text-navy">All services</a>
      <a href="/pricing/" class="rounded-full border border-line bg-white px-6 py-3 font-display text-sm font-bold text-navy">Pricing</a>
    </div>
  </main>
</BaseLayout>
